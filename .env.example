PORT=5000
SESSION_SECRET=change-this-before-production

# Optional Google Custom Search integration.
# If these are empty, ARIA uses its local knowledge cache and a safe fallback.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Payment provider placeholders. Use Stripe/Razorpay in production.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
