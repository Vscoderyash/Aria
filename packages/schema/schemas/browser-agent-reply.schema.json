{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jarvis:schemas:browser-agent-reply:v1",
  "title": "JARVIS Browser Agent Reply v1",
  "type": "object",
  "required": ["action"],
  "properties": {
    "thought": { "type": "string", "maxLength": 240 },
    "say": { "type": "string", "maxLength": 800 },
    "action": { "enum": ["click", "type", "select", "key", "read", "wait", "back", "navigate", "scroll", "ask", "done"] },
    "id": { "type": ["integer", "null"], "minimum": 0 },
    "text": { "type": "string", "maxLength": 4000 },
    "key": { "type": "string", "maxLength": 40 },
    "seconds": { "type": "number", "minimum": 0, "maximum": 5 },
    "submit": { "type": "boolean" },
    "url": { "type": "string", "maxLength": 2048, "pattern": "^https?://" },
    "dir": { "enum": ["up", "down"] }
  },
  "additionalProperties": false
}
