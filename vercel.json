{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/aria-gold run build",
  "outputDirectory": "artifacts/aria-gold/dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://your-api-server.com/api/$1" }
  ]
}
